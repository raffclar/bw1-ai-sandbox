# bw1-ai-sandbox settings for the droplet (installed next to sandbox.py as sandbox.droplet.toml and
# selected with SANDBOX_CONFIG). Same as upstream sandbox.toml except where marked "droplet:".

[vm]
name = "bw1-sandbox"
state_dir = "~/.local/share/bw1-sandbox"   # ssh key, known_hosts, Claude token (token.env), portal token
# droplet: there is no VM, so cpus/memory_mb/disk are unused; the droplet's size is what counts.
cpus = 8
memory_mb = 16384
disk = "20G"
ghidra_port = 8080            # droplet: unused, Ghidra is off (no MCP config in local/)
api_nets = ["160.79.104.0/23"]  # keep in step with API_NETS in /etc/bw1-sandbox/egress.conf

[project]
repo = "bw1-decomp"
upstream = "upstream/main"    # droplet: the host clone's openblack remote is `upstream` (fork = raffclar)
toolchain = ["build/tools", "build/compilers"]

[project.data]
source = "bw1-decomp/orig"
mount = "/opt/orig"
link = "orig"
verify = true
required = "@GAME_VERSION@/runblack-decrypted.exe"   # droplet: from Terraform (game_version)

[worker]
cpus = @WORKER_CPUS@          # droplet: from Terraform (worker_cpus)
memory = "@WORKER_MEMORY@"    # droplet: from Terraform (worker_memory)
preamble = "preamble.md"
# droplet: --version from Terraform (game_version), as the sandbox README says for other versions.
# droplet: after configuring, mark the shared toolchain as built. It is a read-only copy of the host's, and a fresh
# checkout makes the scripts that built it (download_tool.py, patch_compiler_headers.py) newer than it, so ninja would
# try to download and patch it again: that fails with no network and a read-only compiler folder, and workers then
# stub the scripts out. So: the scripts are dated back (content unchanged, so git sees no change), the header-patch
# stamp is written only after checking that the shared headers are already patched, and every toolchain step gets
# its .ninja_log record (ninja reruns any step it has no record of; the hash is ninja's own command hash).
setup = ["python3", "-c", '''
import os, pathlib, re, shutil, subprocess, sys, tempfile

def ninja_hash(command):  # MurmurHash64A with ninja's seed, as ninja's build log stores it
    m, mask = 0xC6A4A7935BD1E995, (1 << 64) - 1
    data = command.encode()
    h = (0xDECAFBADDECAFBAD ^ (len(data) * m)) & mask
    full = len(data) // 8 * 8
    for i in range(0, full, 8):
        k = int.from_bytes(data[i:i + 8], "little") * m & mask
        k = (k ^ (k >> 47)) * m & mask
        h = (h ^ k) * m & mask
    if data[full:]:
        h = (h ^ int.from_bytes(data[full:], "little")) * m & mask
    h = (h ^ (h >> 47)) * m & mask
    return h ^ (h >> 47)

cmd = ["python3", "configure.py", "--version", "@GAME_VERSION@", "--dtk", "build/tools/dtk",
       "--objdiff", "build/tools/objdiff-cli", "--wrapper", "build/tools/wibo", "--compilers", "build/compilers",
       "--lld-link", "build/tools/llvm/bin/lld-link"]
if subprocess.run(cmd).returncode != 0:
    sys.exit(1)
for script in ("tools/download_tool.py", "tools/patch_compiler_headers.py"):
    if os.path.exists(script):
        os.utime(script, (0, 0))
ninja = re.sub(r"[$]\n\s*", " ", pathlib.Path("build.ninja").read_text())  # join continued lines
m = re.search(r"^build (\S+): patch_headers\s+(\S+)", ninja, re.M)
if m:
    stamp, include = pathlib.Path(m.group(1)), pathlib.Path(m.group(2), "include")
    with tempfile.TemporaryDirectory() as tmp:
        copy = pathlib.Path(tmp, "include")
        shutil.copytree(include, copy, copy_function=shutil.copyfile)  # writable copies of the read-only files
        patched = subprocess.run([sys.executable, "tools/patch_compiler_headers.py", str(copy)]).returncode == 0
        # compared as the patch script reads them (it rewrites every file it patches with \n line ends)
        read = lambda f: f.read_text(encoding="utf-8", errors="replace")
        patched = patched and all(read(f) == read(include / f.relative_to(copy)) for f in copy.rglob("*") if f.is_file())
    if not patched:
        sys.exit(f"setup: the shared compiler headers in {include} are not patched (run ninja on the host once)")
    stamp.parent.mkdir(parents=True, exist_ok=True)
    stamp.touch()
log = pathlib.Path(".ninja_log")
lines = [] if log.exists() else ["# ninja log v5"]
for out in re.findall(r"^build (\S+): (?:download_tool|patch_headers)\s", ninja, re.M):
    if os.path.exists(out):
        command = subprocess.run(["ninja", "-t", "commands", "-s", out], capture_output=True, text=True,
                                 check=True).stdout.strip()
        lines.append(f"0\t0\t{os.stat(out).st_mtime_ns}\t{out}\t{ninja_hash(command):x}")
with open(log, "a") as f:
    f.write("".join(line + "\n" for line in lines))
# The project formats with clang-format 22 (AGENTS.md, CI); the image's Debian package is older and formats some
# expressions differently. Provisioning installs 22 into the shared toolchain, and Claude Code's settings put it first
# on PATH for the worker's shells.
import json
formatter = "/work/build/tools/clang-format22/bin"
if os.path.exists(os.path.join(formatter, "clang-format")):
    settings_path = pathlib.Path.home() / ".claude" / "settings.json"
    settings = json.loads(settings_path.read_text()) if settings_path.exists() else {}
    env = settings.setdefault("env", {})
    path = env.get("PATH", os.environ.get("PATH", "/usr/local/bin:/usr/bin:/bin"))
    if not path.startswith(formatter + ":"):
        env["PATH"] = formatter + ":" + path
    settings_path.parent.mkdir(parents=True, exist_ok=True)
    settings_path.write_text(json.dumps(settings, indent=2))
# The project never uses `extern` (AGENTS.md "Globals": a global is a static member of its owning class, and a use
# that can't be declared yet is commented out with a TODO). Two guards, with the publisher refusing a branch that
# adds one as the last: a Claude Code hook that blocks an Edit/Write adding `extern` to a C/C++ file, and a git
# pre-commit hook that refuses a commit adding one (catches shell edits too). Comment lines don't count.
checker = """#!/usr/bin/env python3
import json, os, re, subprocess, sys
EXTERN = re.compile(r"\\bextern\\b")
SOURCES = (".c", ".cpp", ".cc", ".cxx", ".h", ".hpp", ".hh", ".inl", ".inc")
WHY = ("`extern` is never allowed in this project (AGENTS.md, Globals). Declare the global as a static data "
       "member of its owning class in that class's header, or, if it can't be declared there yet, comment the "
       "use out with a // TODO: explaining why.")
def uses(text):
    n = 0
    for line in text.splitlines():
        s = line.strip()
        if not s.startswith(("//", "/*", "*")) and EXTERN.search(s.split("//")[0]):
            n += 1
    return n
if len(sys.argv) > 1 and sys.argv[1] == "pre-commit":
    diff = subprocess.run(["git", "diff", "--cached", "-U0", "--no-color", "--"] + ["*" + s for s in SOURCES],
                          capture_output=True, text=True).stdout
    added = [l[1:].strip() for l in diff.splitlines() if l.startswith("+") and not l.startswith("+++")]
    bad = [l for l in added if uses(l)]
    if bad:
        sys.exit("commit refused: it adds extern: " + "; ".join(bad[:5]) + "\\n" + WHY)
    sys.exit(0)
data = json.load(sys.stdin)
tool, args = data.get("tool_name", ""), data.get("tool_input", {})
path = args.get("file_path", "")
if not path.endswith(SOURCES):
    sys.exit(0)
if tool == "Write":
    old = open(path, encoding="utf-8", errors="replace").read() if os.path.exists(path) else ""
    added = uses(args.get("content", "")) - uses(old)
elif tool == "Edit":
    added = uses(args.get("new_string", "")) - uses(args.get("old_string", ""))
elif tool == "MultiEdit":
    added = sum(uses(e.get("new_string", "")) - uses(e.get("old_string", "")) for e in args.get("edits", []))
else:
    added = 0
if added > 0:
    print("Blocked: this edit adds extern. " + WHY, file=sys.stderr)
    sys.exit(2)
"""
hook = pathlib.Path.home() / ".claude" / "hooks" / "no_extern.py"
hook.parent.mkdir(parents=True, exist_ok=True)
hook.write_text(checker)
hook.chmod(0o755)
settings_path = pathlib.Path.home() / ".claude" / "settings.json"
settings = json.loads(settings_path.read_text()) if settings_path.exists() else {}
pre = settings.setdefault("hooks", {}).setdefault("PreToolUse", [])
if not any(str(hook) in h.get("command", "") for entry in pre for h in entry.get("hooks", [])):
    pre.append({"matcher": "Edit|Write|MultiEdit", "hooks": [{"type": "command", "command": f"python3 {hook}"}]})
settings_path.parent.mkdir(parents=True, exist_ok=True)
settings_path.write_text(json.dumps(settings, indent=2))
git_hook = pathlib.Path(subprocess.run(["git", "rev-parse", "--git-path", "hooks/pre-commit"], capture_output=True,
                                       text=True, check=True).stdout.strip())
git_hook.parent.mkdir(parents=True, exist_ok=True)
git_hook.write_text("#!/bin/sh\nexec python3 " + str(hook) + " pre-commit\n")
git_hook.chmod(0o755)
''']
packages = ["ninja-build", "clang-format", "llvm", "python3-pefile", "python3-yaml"]
