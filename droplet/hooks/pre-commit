#!/bin/sh
# bw1 harness, worker git pre-commit hook (installed by install_hooks.py; its hash is checked at discharge).
# Refuses a commit that adds `extern` or that the quality gate fails (hard failures, which include the anti-cheat
# and tamper rules). Warnings are printed and don't block. Bypassing this hook (--no-verify) gains nothing: the
# Discharge Nurse and the publisher run the same gate on the host.
hooks="$HOME/.claude/hooks"
python3 "$hooks/no_extern.py" pre-commit || exit 1
# Files that had inline asm at the case's base (or the merge-base with origin/main) may keep it: --asm-base
asm_base=$(awk 'NR==1{print $1; exit}' "$HOME/case/gate-base" 2>/dev/null)
[ -n "$asm_base" ] || asm_base=$(git merge-base origin/main HEAD 2>/dev/null)
python3 "$hooks/quality_gate.py" --staged ${asm_base:+--asm-base "$asm_base"}
status=$?
if [ "$status" -eq 1 ]; then
	echo "commit refused by the quality gate (hard failures above). Fix them; don't work around the gate." >&2
	exit 1
fi
if [ "$status" -ne 0 ]; then
	echo "pre-commit: the quality gate could not run (exit $status); the commit goes ahead, the host re-checks it" >&2
fi
exit 0
