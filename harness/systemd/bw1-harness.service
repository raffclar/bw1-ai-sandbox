[Unit]
Description=bw1-decomp matching harness (one run)
Documentation=file:///opt/bw1-harness/harness
Wants=network-online.target
After=network-online.target
# Kill switch: touch /etc/bw1-harness/STOP and no new run starts.
ConditionPathExists=!/etc/bw1-harness/STOP

[Service]
Type=oneshot
User=harness
Group=harness
WorkingDirectory=/opt/bw1-harness
ExecStartPre=/opt/bw1-harness/harness/check-ready.sh
ExecStart=/opt/bw1-harness/harness/bw1-harness.sh
# Hard wall-clock cap for a whole run (build + agent + verify).
TimeoutStartSec=6h
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
