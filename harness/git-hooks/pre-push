#!/usr/bin/env bash
# Installed into the harness checkout's .git/hooks. Every push must CREATE a new branch under
# $BRANCH_PREFIX: updating an existing branch (and so any force push), deleting a branch,
# pushing tags or touching main are all refused.
set -euo pipefail

BRANCH_PREFIX=harness/
if [[ -r /etc/bw1-harness/config.env ]]; then
	# shellcheck disable=SC1091
	source /etc/bw1-harness/config.env
fi
[[ "$BRANCH_PREFIX" == */ && "$BRANCH_PREFIX" != main* ]] || { echo "pre-push: bad BRANCH_PREFIX" >&2; exit 1; }

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
	: "$local_ref"
	if [[ "$remote_ref" != "refs/heads/$BRANCH_PREFIX"* ]]; then
		echo "pre-push: refusing $remote_ref (only refs/heads/$BRANCH_PREFIX*)" >&2
		status=1
	elif [[ "$local_sha" == "$zero" ]]; then
		echo "pre-push: refusing to delete $remote_ref" >&2
		status=1
	elif [[ "$remote_sha" != "$zero" ]]; then
		echo "pre-push: $remote_ref already exists; the harness only creates new branches" >&2
		status=1
	fi
done
exit "$status"
