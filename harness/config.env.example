# bw1-harness settings. On the droplet this file is /etc/bw1-harness/config.env and
# Terraform writes it from its variables. No secrets here: the credentials live in
# /etc/bw1-harness/secrets.env (mode 0640, root:harness): CLAUDE_CODE_OAUTH_TOKEN (subscription,
# preferred) and/or ANTHROPIC_API_KEY, plus GH_TOKEN.

# Where things live on the droplet.
REPO_DIR=/srv/bw1-harness/bw1-decomp
STATE_DIR=/var/lib/bw1-harness
LOG_DIR=/var/log/bw1-harness
STOP_FILE=/etc/bw1-harness/STOP
VENV_DIR=/opt/bw1-harness/venv

# GitHub. Branches are pushed to FORK_REPO; PRs are opened against PR_REPO (base PR_BASE).
UPSTREAM_REPO=openblack/bw1-decomp
FORK_REPO=raffclar/bw1-decomp
PR_REPO=raffclar/bw1-decomp
PR_BASE=main
PR_DRAFT=true
BRANCH_PREFIX=harness/
GIT_AUTHOR_NAME="bw1-decomp harness"
GIT_AUTHOR_EMAIL=harness@example.invalid

# Agent.
CLAUDE_MODEL=claude-opus-5-5
MAX_TURNS=150
# Dollar caps apply in API-key mode only (subscription runs report estimates).
MAX_USD_PER_RUN=5
RUN_TIMEOUT_MIN=120
CYCLES_PER_FUNCTION=12

# Safety limits (per UTC day unless noted).
MAX_PRS_PER_DAY=3
MAX_OPEN_PRS=5
MAX_USD_PER_DAY=25
MAX_RUNS_PER_DAY=12
# After a usage or rate limit, no run starts for this many minutes (or until the reported reset).
RATE_LIMIT_BACKOFF_MIN=180

# Work selection.
VERSION=BW1W120
MAX_FUNCTIONS=4
MIN_SIZE=16
MAX_SIZE=600
MIN_FUZZY=50
MAX_FUZZY=99.5
COOLDOWN_DAYS=7
MIN_FUZZY_GAIN=0.5
ALLOWED_PATHS=src/*,include/*
