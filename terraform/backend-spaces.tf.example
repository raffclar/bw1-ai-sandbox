# Optional remote state in a DigitalOcean Spaces bucket (S3-compatible).
# Copy to backend.tf, create the bucket first, then `terraform init -migrate-state`.
# Credentials come from the environment: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY set to a
# Spaces access key. Never put them in this file.
terraform {
  backend "s3" {
    bucket                      = "your-terraform-state-bucket"
    key                         = "bw1-harness/terraform.tfstate"
    region                      = "us-east-1" # ignored by Spaces, required by the backend
    endpoints                   = { s3 = "https://lon1.digitaloceanspaces.com" }
    skip_credentials_validation = true
    skip_requesting_account_id  = true
    skip_metadata_api_check     = true
    skip_region_validation      = true
    skip_s3_checksum            = true
    use_path_style              = false
  }
}
