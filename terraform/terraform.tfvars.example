# Copy to terraform.tfvars (gitignored) and fill in. NO SECRETS IN THIS FILE:
# the DigitalOcean token, the Anthropic API key and the GitHub token come from the
# environment only (deploy.ps1 sets DIGITALOCEAN_TOKEN, TF_VAR_anthropic_api_key and
# TF_VAR_github_token from the tokens file).

ssh_allowed_cidrs = ["203.0.113.7/32"] # your public IP

# The fork the GitHub token can push to (branches go here, never to upstream).
fork_repo = "your-github-user/bw1-decomp"
# Empty: PRs open against the fork. "openblack/bw1-decomp": PRs open upstream.
pr_repo  = ""
pr_draft = true

git_author_name  = "Your Name"
git_author_email = "12345+your-github-user@users.noreply.github.com"

# Original game files: "archive" (made by scripts/pack-orig.ps1), "ghcr" or "manual".
orig_source       = "archive"
orig_archive_path = "E:/bw1-decomp/orig-BW1W120.tar.gz"

# region          = "lon1"
# droplet_size    = "s-8vcpu-16gb"
# ssh_public_key_path  = "~/.ssh/id_ed25519.pub"
# ssh_private_key_path = "~/.ssh/id_ed25519"

# Agent and limits.
# claude_model     = "claude-opus-5-5"
# max_turns        = 150
# max_usd_per_run  = 5
# max_usd_per_day  = 25
# max_prs_per_day  = 3
# max_open_prs     = 5
# run_interval     = "2h"
# harness_enabled  = true
