# Copy to terraform.tfvars (gitignored) and fill in. NO SECRETS IN THIS FILE: the DigitalOcean
# token, the Claude subscription token, the GitHub token and any bw1-build token come from the
# environment only (deploy.ps1 sets DIGITALOCEAN_TOKEN and the TF_VAR_* variables from the tokens file).

ssh_allowed_cidrs = ["203.0.113.7/32"] # your public IP

# Your fork: the publisher pushes ai-sandbox/* branches and opens draft PRs here only.
fork_repo = "raffclar/bw1-decomp"

# Original game files. Default: your zip (single top folder bw1-original/ or orig/), uploaded to the
# droplet host, unpacked into bw1-decomp/orig/ there, verified, then deleted. A .tar.gz from
# scripts/pack-orig.ps1 works too.
orig_source       = "archive"
orig_archive_path = "E:/bw1-original.zip"
# Alternative: clone the private openblack/bw1-build repo on the droplet host (needs a read-only deploy
# key from scripts/new-bw1-build-key.ps1, or "github_bw1_build" in the tokens file):
# orig_source        = "git"
# game_version       = "BW1W120"
# keep_bw1_build_key = false

# do_project_id        = "0a017c67-5e46-4f17-9a26-d8f40de0ae7b"   # existing project "for bw1-decomp"
# region               = "lon1"
# droplet_size         = "s-8vcpu-16gb"
# ssh_public_key_path  = "~/.ssh/id_ed25519.pub"
# ssh_private_key_path = "~/.ssh/id_ed25519"

# bw1-ai-sandbox, pinned to the commit the droplet wrapper was written against.
# sandbox_ref    = "3b6e2390ef9b898ee94ad6604efc1745b13e4179"
# bw1_decomp_ref = "main"   # what `sync` gives workers as their base
# worker_cpus    = 2
# worker_memory  = "4g"

# Services.
# autoresume_enabled = true
# portal_enabled     = false   # localhost only; use the SSH tunnel in `terraform output portal_tunnel`
# orchestrator_tools = true
# publisher_enabled  = true

# Publisher limits.
# publish_interval = "30min"
# max_prs_per_day  = 3
# max_open_prs     = 5
# allowed_paths    = ["src/*", "include/*", "tools/matching_ledger.jsonl"]
