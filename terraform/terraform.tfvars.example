# Copy to terraform.tfvars (gitignored) and fill in. NO SECRETS IN THIS FILE: the DigitalOcean
# token, the Claude subscription token and the GitHub tokens come from the environment only
# (deploy.ps1 sets DIGITALOCEAN_TOKEN and the TF_VAR_* variables from the tokens file).

ssh_allowed_cidrs = ["203.0.113.7/32"] # your public IP

# Your fork: the ONLY place the publisher pushes (new ai-sandbox/* branches).
fork_repo = "raffclar/bw1-decomp"

# Where the draft PRs go: "fork" (raffclar/bw1-decomp) or "openblack" (openblack/bw1-decomp, head
# raffclar:<branch>; needs "github_openblack_pr" in the tokens file, see scripts/new-github-credentials.ps1).
pr_target = "fork"

# The project checkout: your local clone (git bundle of all refs, checked out at your HEAD on the
# droplet), or "upstream" for a fresh clone of openblack/bw1-decomp at bw1_decomp_ref.
repo_source     = "local"
local_repo_path = "E:/bw1-decomp/bw1-decomp"

# Game files: "local" = orig/ of that clone (game_version, or orig_upload_versions, plus libs/ and
# directx7.0/ only). If it lacks them, deploy.ps1 falls back to orig_archive_path. Alternatives:
# "archive" (your zip, or a pack-orig.ps1 .tar.gz) and "manual".
orig_source       = "local"
orig_archive_path = "E:/bw1-original.zip"
# orig_upload_versions = ["BW1W120"]

# do_project_id        = "0a017c67-5e46-4f17-9a26-d8f40de0ae7b"   # existing project "for bw1-decomp"
# region               = "lon1"
# droplet_size         = "s-8vcpu-16gb"
# ssh_public_key_path  = "~/.ssh/id_ed25519.pub"
# ssh_private_key_path = "~/.ssh/id_ed25519"

# bw1-ai-sandbox, pinned to the commit the droplet wrapper was written against.
# sandbox_ref    = "3b6e2390ef9b898ee94ad6604efc1745b13e4179"
# bw1_decomp_ref = "main"   # repo_source = "upstream" only; with "local" your HEAD is the base
# worker_cpus    = 2
# worker_memory  = "4g"

# Services.
# autoresume_enabled = true
# portal_enabled     = false   # localhost only; use the SSH tunnel in `terraform output portal_tunnel`
# orchestrator_tools = true
# publisher_enabled  = true
# ghidra_enabled     = true    # headless Ghidra + GhidraMCP for workers, docker0 gateway only
# ghidra_mode        = "rw"    # "ro" refuses the MCP rename/comment/type tools

# Publisher limits.
# publish_interval = "30min"
# max_prs_per_day  = 3
# max_open_prs     = 5
# allowed_paths    = ["src/*", "include/*", "tools/matching_ledger.jsonl"]

# Reviewer comments on harness PRs are collected every 15 minutes. Optionally feed them back to the
# worker that made the PR (off by default; only comments from these logins, default the fork owner).
# feedback_to_sandbox = false
# feedback_authors    = ["raffclar"]

# Who the published commits are by (you; use an email your GitHub account owns). Unset, they carry the worker's
# "sandbox <name>" identity. Each commit also ends with a Co-Authored-By Claude trailer.
# commit_author_name  = "your-github-name"
# commit_author_email = "you@example.com"
